{
  "name": "e3dex",
  "displayName": "E3DEX",
  "version": "4.3.3",
  "description": "현재 열린 E3D 프로젝트·MDB와 쓰기 가능한 DB·SITE를 읽고 사용자가 선택한 위치에 작업합니다. PIPE 끝단 처리, GS 구조·브레이싱, 장비 CTOR·VP 노즐, PLAN/DXF 기능을 제공합니다. 정확한 세션과 대상 DB를 실행 직전에 검증합니다. Windows x64 / E3D 2.1 전용입니다. 관리자가 승인한 계정만 사용할 수 있으며, 배관·구조·장비·PLAN 생성은 관리 서버에서 실행되어 항상 최신 버전이 적용됩니다.",
  "author": {
    "name": "E3DEX Team"
  },
  "keywords": [
    "aveva",
    "e3d",
    "pml",
    "piping",
    "structures",
    "equipment",
    "plan",
    "dxf"
  ],
  "mcpServers": {
    "e3d_sessions": {
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${CLAUDE_PLUGIN_ROOT}/scripts/launch.ps1",
        "mcp"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    }
  }
}
